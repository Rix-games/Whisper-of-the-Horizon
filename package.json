{
  "name": "whisper-of-the-horizon",
  "version": "1.0.0-alfa",
  "private": true,
  "description": "Šepot Horizontu – klidná inkrementální vesmírná hra postavená na skutečné fyzice.",
  "type": "module",
  "scripts": {
    "build": "tsc -p . && esbuild src/main.ts --bundle --format=iife --target=es2020 --outfile=web/hra.js",
    "watch": "esbuild src/main.ts --bundle --format=iife --target=es2020 --outfile=web/hra.js --watch",
    "serve": "npx --yes serve web",
    "sim": "esbuild sim/balance.ts --bundle --platform=node --format=esm --outfile=sim/.out.mjs --log-level=warning && node sim/.out.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tsx": "4.23.12",
    "esbuild": "0.28.2"
  }
}
